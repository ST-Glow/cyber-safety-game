; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="AI训练场大挑战"
run/main_scene="res://scenes/main_menu.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")

[autoload]

PauseCoordinator="*res://scripts/pause_coordinator.gd"
AiAssistantService="*res://scripts/ai_assistant_service.gd"
CampaignSession="*res://scripts/campaign_session.gd"
DigCompSession="*res://scripts/digcomp_session.gd"
ExperimentSession="*res://scripts/experiment_session.gd"
ExperimentWebBridge="*res://scripts/experiment_web_bridge.gd"
SceneTransition="*res://scripts/scene_transition.gd"
SceneNavigation="*res://scripts/ui/scene_navigation.gd"

[debug]

file_logging/enable_file_logging.pc=false

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/handheld/orientation=1

