[ext_resource type="Script" path="res://resources/quiz_question.gd" id="1_quiz"]

[resource]
script = ExtResource("1_quiz")
task_id = "party_content_revision"
digcomp_area_id = "area_3"
competence_id = "digital_content_creation"
