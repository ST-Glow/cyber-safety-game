PORT=8787
UPLOAD_LINK_SECRET=replace-with-at-least-32-random-characters
ALLOWED_ORIGINS=http://127.0.0.1:4173,http://localhost:4173,https://YOUR-USER.github.io
OSS_REGION=oss-cn-hangzhou
OSS_BUCKET=replace-with-private-data-bucket
OSS_UPLOAD_ROLE_ARN=acs:ram::1234567890123456:role/cyber-safety-browser-upload
OSS_INTERNAL=false

# Required on Vercel. Use a dedicated least-privilege RAM user, never the main account AccessKey.
ALIBABA_CLOUD_ACCESS_KEY_ID=replace-with-restricted-ram-user-access-key-id
ALIBABA_CLOUD_ACCESS_KEY_SECRET=replace-with-restricted-ram-user-access-key-secret

# Coze/扣子智能体。PAT 只保存在服务端，绝不能写入 web-game 或 GitHub Pages。
COZE_API_TOKEN=replace-with-coze-personal-access-token
COZE_BOT_ID=replace-with-published-coze-bot-id

# Local end-to-end simulation only. Remove this in Function Compute.
MOCK_OSS_ROOT=../../mock-oss
PUBLIC_BASE_URL=http://127.0.0.1:8787
