PORT=8787
UPLOAD_LINK_SECRET=replace-with-at-least-32-random-characters
ALLOWED_ORIGINS=http://127.0.0.1:4173,http://localhost:4173,http://127.0.0.1:4174,http://localhost:4174,https://YOUR-USER.github.io

# The data bucket remains in Hangzhou. A Hong Kong Function Compute instance
# must use the public OSS endpoint, so keep OSS_INTERNAL=false.
OSS_REGION=oss-cn-hangzhou
OSS_BUCKET=replace-with-private-data-bucket
OSS_UPLOAD_ROLE_ARN=acs:ram::1234567890123456:role/cyber-safety-browser-upload
OSS_INTERNAL=false

# Use the STS endpoint nearest to the backend deployment.
# Vercel/current default: https://sts.cn-hangzhou.aliyuncs.com
# Function Compute Hong Kong: https://sts.cn-hongkong.aliyuncs.com
STS_ENDPOINT=https://sts.cn-hongkong.aliyuncs.com

# Use either Function Compute execution-role credentials (recommended) or a
# dedicated least-privilege RAM user. Never use the main-account AccessKey.
ALIBABA_CLOUD_ACCESS_KEY_ID=
ALIBABA_CLOUD_ACCESS_KEY_SECRET=

# Coze JWT OAuth automatically obtains and refreshes short-lived access tokens.
COZE_BOT_ID=replace-with-published-api-bot-id
COZE_JWT_OAUTH_CLIENT_ID=replace-with-oauth-client-id
COZE_JWT_OAUTH_PUBLIC_KEY_ID=replace-with-public-key-id
COZE_JWT_OAUTH_PRIVATE_KEY=replace-with-complete-private-key-pem

# Optional fallback only. OAuth takes precedence when fully configured.
COZE_API_TOKEN=

# Required for the in-game assistant. Store only on the server. Each value is
# the hidden teaching profile for that level; never copy this JSON into Godot.
AI_LEVEL_PROMPTS_JSON={"ai_training_ground":"replace-on-server","spinner_race":"replace-on-server","data_chip_hunt":"replace-on-server","signal_bomb_survival":"replace-on-server"}

# Local end-to-end simulation only. Remove both in Function Compute.
MOCK_OSS_ROOT=../../mock-oss
PUBLIC_BASE_URL=http://127.0.0.1:8787
